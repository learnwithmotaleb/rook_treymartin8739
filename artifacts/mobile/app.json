{
  "expo": {
    "name": "Rook",
    "slug": "rook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.getrook.app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getrook.app",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.utilities",
        "NSCameraUsageDescription": "Rook uses your camera to scan photos for your identity fingerprint.",
        "NSPhotoLibraryUsageDescription": "Rook accesses your photos to build your identity fingerprint and detect stolen images.",
        "NSUserNotificationsUsageDescription": "Rook sends real-time alerts when threats to your identity are detected.",
        "NSFaceIDUsageDescription": "Rook uses Face ID to protect access to your identity data.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.getrook.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070B12"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "@clerk/expo",
      "expo-apple-authentication",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6",
          "sounds": [],
          "mode": "production"
        }
      ],
      "./plugins/withModularHeaders",
      "./plugins/withPrivacyManifest"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d18c0a79-c32e-483e-ba77-7f64bb35714f"
      }
    },
    "owner": "treylane100",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/d18c0a79-c32e-483e-ba77-7f64bb35714f"
    }
  }
}
