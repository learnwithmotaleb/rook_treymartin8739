{
  "expo": {
    "name": "Rook",
    "slug": "rook",
    "version": "1.0.0",
    "privacyPolicyUrl": "https://tryrook.app/api/legal/privacy",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getrook.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.utilities",
        "NSCameraUsageDescription": "Rook uses your camera to scan photos for your identity fingerprint.",
        "NSPhotoLibraryUsageDescription": "Rook accesses your photos to build your identity fingerprint and detect stolen images.",
        "NSUserNotificationsUsageDescription": "Rook sends real-time alerts when threats to your identity are detected.",
        "NSFaceIDUsageDescription": "Rook uses Face ID to protect access to your identity data.",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appStoreAgeRating": "4+",
      "_ageRatingNote": "Age rating (4+, All Ages) is configured in App Store Connect → App Information → Age Rating. It cannot be encoded in app.json — Expo/EAS has no config key for this. See metadata/README.md and SUBMISSIONS.md Section 2a for the exact questionnaire answers."
    },
    "android": {
      "package": "com.getrook.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070B12"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6",
          "sounds": [],
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
