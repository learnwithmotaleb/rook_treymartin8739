modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18116
externalPort = 5173

[[ports]]
localPort = 18150
externalPort = 3003

[userenv]

[userenv.shared]
REVENUECAT_PROJECT_ID = "projdfc72169"
REVENUECAT_TEST_STORE_APP_ID = "app95134497ae"
REVENUECAT_APPLE_APP_STORE_APP_ID = "appda4fab2dd3"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "app1b2c1e97c8"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_mXSLgUKANWRzlgJEsRkzoVuyjhm"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_quPffgMMsfSCkLWukRfjzYLMYKp"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_VYCCTVzYYbXIwHrnFtoZvWdsusH"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_test_cGlja2VkLWdyaWZmb24tNDYuY2xlcmsuYWNjb3VudHMuZGV2JA"
OAUTH_REDIRECT_BASE_URL = "tryrook.app"
WEBHOOK_VERIFY_TOKEN = "rook_webhook_verify_2025"

[userenv.development]
EXPO_PUBLIC_DOMAIN = "tryrook.app"

[userenv.production]
EXPO_PUBLIC_DOMAIN = "tryrook.app"

[nix]
channel = "stable-25_05"
